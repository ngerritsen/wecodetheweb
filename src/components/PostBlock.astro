---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

export interface Props {
  title: string;
  excerpt: string;
  slug: string;
  image: ImageMetadata;
  url: string;
}

const { title, excerpt, slug, image, url } = Astro.props;
---

<div class="post-block">
  <Image
    src={image}
    alt=""
    width={800}
    height={600}
    format="webp"
    quality={75}
    class="post-block__image"
    loading="lazy"
    aria-hidden="true"
  />
  <a href={url} title={`Read: ${title}`}>
    <div class="post-block__content">
      <h2 class="post-block__title">{title}</h2>
      <div class="post-block__excerpt" set:html={excerpt} />
    </div>
  </a>
</div>
